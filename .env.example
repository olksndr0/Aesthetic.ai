# ───────── Core ─────────
# Public URL of the site (no trailing slash). Used for Stripe redirects, emails, sitemap.
APP_URL="http://localhost:3000"

# PostgreSQL. The default matches docker-compose.yml (npm run db:up).
DATABASE_URL="postgresql://aesthetic:aesthetic@localhost:5433/aesthetic?schema=public"

# Admin account created by `npm run db:seed`. Change the password before seeding in production.
ADMIN_EMAIL="admin@aesthetic-ai.example"
ADMIN_PASSWORD="change-me-please-12"

# ───────── AI image-to-image provider ─────────
# "openai" (gpt-image-1 edits) or "replicate" (FLUX Kontext). Leave empty to auto-detect from the keys below.
# With no key set, the simulator refuses to generate and explains how to configure it. Nothing is faked.
AI_PROVIDER=""
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-1"
REPLICATE_API_TOKEN=""
REPLICATE_MODEL="black-forest-labs/flux-kontext-pro"
# Max simultaneous generations in this server process. Premium users jump the queue.
AI_MAX_CONCURRENCY="2"
AI_TIMEOUT_MS="180000"

# ───────── Stripe ─────────
# Test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# From `npm run stripe:listen` locally, or the webhook endpoint page in the dashboard in production.
STRIPE_WEBHOOK_SECRET=""

# ───────── Storage (always private) ─────────
# "local" stores under STORAGE_LOCAL_DIR (outside /public). "s3" works with AWS S3, Cloudflare R2, MinIO.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ───────── Privacy ─────────
# Photos and results are deleted automatically this many days after creation.
IMAGE_RETENTION_DAYS="30"
# Bearer secret for GET /api/cron/cleanup (call it daily from your scheduler).
CRON_SECRET=""

# ───────── Email (Resend) ─────────
# Without a key, emails are printed to the server console in development and skipped in production.
RESEND_API_KEY=""
EMAIL_FROM="Aesthetic AI <no-reply@aesthetic-ai.example>"
CONTACT_INBOX="hello@aesthetic-ai.example"
