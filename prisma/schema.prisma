generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SimulationStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                   String           @id @default(cuid())
  email                String           @unique
  passwordHash         String
  name                 String?
  role                 Role             @default(USER)
  credits              Int              @default(0)
  planSlug             String           @default("starter")
  billingInterval      BillingInterval?
  stripeCustomerId     String?          @unique
  stripeSubscriptionId String?          @unique
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean          @default(false)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  sessions    Session[]
  resetTokens PasswordResetToken[]
  simulations Simulation[]
  cases       PlanningCase[]

  @@index([planSlug])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Plan {
  slug              String   @id
  name              String
  description       String   @default("")
  priceMonthlyCents Int
  priceYearlyCents  Int
  credits           Int
  features          String[]
  allProcedures     Boolean  @default(false)
  highResolution    Boolean  @default(false)
  history           Boolean  @default(false)
  priority          Boolean  @default(false)
  popular           Boolean  @default(false)
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  updatedAt         DateTime @updatedAt
}

model Simulation {
  id           String           @id @default(cuid())
  userId       String
  procedure    String
  params       Json
  status       SimulationStatus @default(PROCESSING)
  originalKey  String?
  resultKey    String?
  /// Side-profile view. `originalKey` / `resultKey` hold the front view.
  profileOriginalKey String?
  profileResultKey   String?
  provider     String?
  errorCode    String?
  errorMessage String?
  durationMs   Int?
  consentAt    DateTime
  createdAt    DateTime         @default(now())
  expiresAt    DateTime?
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([expiresAt])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

/// A 3D planning case: anatomical data, landmarks, an operator-defined plan and its results.
model PlanningCase {
  id                String    @id @default(cuid())
  userId            String
  title             String
  /// Consent to store and process anatomical data and photographs.
  consentAt         DateTime
  /// Consent to send renders and photographs to the external image provider. Null until given.
  providerConsentAt DateTime?
  landmarks         Json      @default("[]")
  measures          Json      @default("[]")
  plan              Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  expiresAt         DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  assets  CaseAsset[]
  results CaseResult[]

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// One stored file of a case. Geometry is kept in the file's own coordinates;
/// `transform` (4x4, row-major) takes it to the canonical frame in millimetres.
model CaseAsset {
  id         String   @id @default(cuid())
  caseId     String
  /// skull | face | implant | photo | render
  kind       String
  /// acquired | estimated | derived
  provenance String
  /// Layer name, or the view id for photographs and renders.
  label      String
  key        String
  bytes      Int
  meta       Json     @default("{}")
  transform  Json?
  resultId   String?
  createdAt  DateTime @default(now())
  case       PlanningCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  result     CaseResult?  @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([resultId])
}

/// A simulation of one plan: geometric renders of every view from one model state,
/// and optionally the photographic versions with their geometry check.
model CaseResult {
  id          String   @id @default(cuid())
  caseId      String
  plan        Json
  engine      Json
  stats       Json
  /// Per view: scale, region of interest, photographic status and verification.
  views       Json
  /// none | processing | completed | failed
  photoStatus String   @default("none")
  photoError  String?
  provider    String?
  createdAt   DateTime @default(now())
  case        PlanningCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  files       CaseAsset[]

  @@index([caseId, createdAt])
}
